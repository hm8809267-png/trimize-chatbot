// ============================================================
// منطق البحث
// ============================================================
function findAnswer(text) {
  const q = text.toLowerCase().trim();
  if (!q) return null;

  // 1. Exact FAQ matching للمنتجات
  const faqPatterns = [
    // T1
    { q: ['زيرو', 'صفر', 'تحلق زيرو'], a: kb.t1_zero.response },
    { q: ['تجرح', 'جرح', 'تقطع'], a: kb.t1_cut.response },
    { q: ['مش شغالة', 'مش بتشتغل', 'لا يعمل', 'مش شغال'], a: kb.t1_charge.response },
    { q: ['ضمان الماكينة', 'ضمان الجروح', 'صيانة الماكينة'], a: kb.t1_warranty.response },
    { q: ['شحن الماكينة', 'البطارية', 'الشاحن'], a: kb.t1_charge.response },
    // Deodorant
    { q: ['ألومنيوم', 'أملاح'], a: kb.deodorant_faq.response },
    { q: ['12 ساعة', 'تدوم الرائحة'], a: kb.deodorant_faq.response },
    { q: ['بعد إزالة الشعر', 'بعد الحلاقة'], a: kb.deodorant_faq.response },
    // Wash
    { q: ['بشرة حساسة', 'الغسول حساس'], a: kb.wash_faq.response },
    { q: ['كحول', 'بارابين', 'سلفات'], a: kb.wash_faq.response },
    { q: ['جفاف', 'الغسول يجفف'], a: kb.wash_faq.response },
    // Shower
    { q: ['الفرق بين الغسول والشاور', 'فرق غسول شاور'], a: kb.shower_faq.response },
    { q: ['جفاف الشاور', 'الشاور يجفف'], a: kb.shower_faq.response },
  ];

  for (const pattern of faqPatterns) {
    for (const keyword of pattern.q) {
      if (q.includes(keyword)) return pattern.a;
    }
  }

  // 2. Keyword matching للـ categories
  for (const [key, item] of Object.entries(kb)) {
    if (item.keywords) {
      for (const keyword of item.keywords) {
        if (q.includes(keyword.toLowerCase())) {
          return item.response;
        }
      }
    }
  }

  return null;
}

// ============================================================
// واجهة الشات
// ============================================================
const messagesDiv = document.getElementById('messages');
const input = document.getElementById('userInput');
let lastQuestion = '';

function addMessage(sender, text) {
  const div = document.createElement('div');
  div.className = `message ${sender}-msg`;
  div.innerHTML = text.replace(/\n/g, '<br>');
  messagesDiv.appendChild(div);
  messagesDiv.scrollTop = messagesDiv.scrollHeight;
}

// رسالة الترحيب
setTimeout(() => {
  addMessage('bot', kb.greetings.response + '\n\n👇 اختار موضوع أو اكتب سؤالك:');
  showQuickButtons();
}, 400);

function showQuickButtons() {
  const div = document.createElement('div');
  div.className = 'quick-buttons';
  const buttons = ['منتجاتنا', 'الشحن', 'الأسعار', 'التواصل', 'الضمان'];
  buttons.forEach(btn => {
    const b = document.createElement('button');
    b.className = 'quick-btn';
    b.textContent = btn;
    b.onclick = () => {
      input.value = btn;
      sendMessage();
    };
    div.appendChild(b);
  });
  messagesDiv.appendChild(div);
  messagesDiv.scrollTop = messagesDiv.scrollHeight;
}

function sendMessage() {
  const text = input.value.trim();
  if (!text) return;
  addMessage('user', text);
  input.value = '';
  lastQuestion = text;

  setTimeout(() => {
    const answer = findAnswer(text);
    if (answer) {
      addMessage('bot', answer);
    } else {
      addMessage('bot', 'عذراً، مش قادر أجاوب على السؤال ده بالضبط. 😕\n\nعايز أساعدك تواصل مع فريق الدعم؟');
      showEscalation();
    }
  }, 500);
}

function showEscalation() {
  const div = document.createElement('div');
  div.className = 'escalate-box';
  div.innerHTML = `
    <div style="font-size:13px;margin-bottom:6px;">📩 سيب بياناتك وهنرد عليك:</div>
    <button onclick="openWhatsApp()">💬 تواصل عبر واتساب</button>
    <button onclick="openEmail()" style="background:#007bff;margin-right:6px;">📧 إرسال إيميل</button>
  `;
  messagesDiv.appendChild(div);
  messagesDiv.scrollTop = messagesDiv.scrollHeight;
}

function openWhatsApp() {
  const msg = `استفسار من شات بوت تريمايز:%0Aالسؤال: ${encodeURIComponent(lastQuestion)}`;
  window.open(`https://wa.me/201034472705?text=${msg}`, '_blank');
  addMessage('bot', '✅ هنفتح لك واتساب مباشرة مع فريق الدعم.');
}

function openEmail() {
  const subject = encodeURIComponent('استفسار من شات بوت تريمايز');
  const body = encodeURIComponent(`السؤال: ${lastQuestion}\n\n[تم الإرسال تلقائياً من شات بوت تريمايز]`);
  window.open(`mailto:info@trimize.com?subject=${subject}&body=${body}`, '_blank');
  addMessage('bot', '✅ تم فتح تطبيق الإيميل. أرسل رسالتك وفريق الدعم هيرد عليك.');
}

input.addEventListener('keypress', (e) => {
  if (e.key === 'Enter') sendMessage();
});
</script>

